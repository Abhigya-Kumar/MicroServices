# Microservices Environment Configuration Template
# Copy this file to `.env` and populate with actual credentials

# Service Ports
PORT=3000
AUTH_PORT=3001
TASK_PORT=3002
MEDIA_PORT=3003
WORKFLOW_PORT=3004

# Internal Microservice URLs (Used by API Gateway)
AUTH_SERVICE_URL=http://localhost:3001
TASK_SERVICE_URL=http://localhost:3002
MEDIA_SERVICE_URL=http://localhost:3003
WORKFLOW_SERVICE_URL=http://localhost:3004

# Logging Level (info, debug, warn, error)
LOG_LEVEL=info

# Database Connection (Neon PostgreSQL / Local PostgreSQL)
# Example: postgresql://neondb_owner:password@ep-cool-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/microservices_db

# Security & Authentication Secrets
JWT_SECRET=dev-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d
GATEWAY_SECRET=gateway-shared-internal-secret

# AWS S3 / Cloudflare R2 / MinIO Storage Credentials (Media Service)
AWS_ENDPOINT_URL_S3=https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=auto
STORAGE_BUCKET=microservices-media-bucket

# Kafka Broker Configuration (Message Broker)
KAFKA_BROKERS=localhost:9092
